/example/
/docs/

# ── 构建产物 ─────────────────────────────────────────────────────────
/build/
/bin/
*.exe
*.test
*.out
*.o
*.a

# 生成的图标资源（rsrc.syso 已随仓库提供；重新生成后如需更新请显式提交）
/build/windows/
*.ico.tmp

# ── 本地运行生成 ─────────────────────────────────────────────────────
# 配置文件（内含本机网卡/串口/IP 等个人环境信息）
/config/
**/config/config.json
# 点表数据库（工程数据，体积大且含业务信息）
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# ── 临时文件 / 日志 ──────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.rej
*~
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── 编辑器 / IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
.claude/
*.swp
*.swo

